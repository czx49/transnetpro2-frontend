{
  "openapi": "3.0.3",
  "info": {
    "title": "TransNetPro API",
    "description": "TransNetPro 项目接口文档",
    "version": "1.0.0",
    "contact": {
      "name": "TransNetPro Team"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "本地开发服务器"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ResponseJson": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 200
          },
          "message": {
            "type": "string",
            "example": "success"
          },
          "data": {
            "type": "object"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "description": "用户名"
          },
          "password": {
            "type": "string",
            "description": "密码"
          }
        }
      },
      "ProjectRequest": {
        "type": "object",
        "required": [
          "name",
          "desc"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "项目名称"
          },
          "desc": {
            "type": "string",
            "description": "项目描述"
          }
        }
      },
      "ProjectEditRequest": {
        "type": "object",
        "required": [
          "id",
          "name",
          "desc"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "description": "项目ID"
          },
          "name": {
            "type": "string",
            "description": "项目名称"
          },
          "desc": {
            "type": "string",
            "description": "项目描述"
          }
        }
      },
      "ProjectDeleteRequest": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "description": "项目ID"
          }
        }
      },
      "ProjectDetailRequest": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "description": "项目ID"
          }
        }
      },
      "ClearTableRequest": {
        "type": "object",
        "required": [
          "project_id",
          "table"
        ],
        "properties": {
          "project_id": {
            "type": "integer",
            "description": "项目ID"
          },
          "table": {
            "type": "string",
            "description": "表名",
            "enum": [
              "bus_community",
              "bus_point",
              "bus_way",
              "road_community",
              "road_point",
              "road_way",
              "other_od",
              "other_toll_gate",
              "other_mobile_cdr",
              "other_bus_card_records",
              "other_taxi_trip",
              "other_population"
            ]
          }
        }
      },
      "OverwriteTableRequest": {
        "type": "object",
        "required": [
          "project_id",
          "table"
        ],
        "properties": {
          "project_id": {
            "type": "integer",
            "description": "项目ID",
            "example": 31
          },
          "table": {
            "type": "string",
            "description": "表名"
          }
        }
      },
      "ChangePasswordRequest": {
        "type": "object",
        "required": [
          "oldPassword",
          "newPassword",
          "confirmNewPassword"
        ],
        "properties": {
          "oldPassword": {
            "type": "string",
            "description": "旧密码"
          },
          "newPassword": {
            "type": "string",
            "description": "新密码"
          },
          "confirmNewPassword": {
            "type": "string",
            "description": "确认新密码"
          }
        }
      },
      "CaseAddRequest": {
        "type": "object",
        "required": [
          "name",
          "case_type_id",
          "project_id"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "方案名称"
          },
          "case_type_id": {
            "type": "integer",
            "description": "类型ID"
          },
          "road_types": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "道路类型列表（可选）"
          },
          "bus_types": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "公交类型列表（可选）"
          },
          "other_types": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "其他类型列表（可选）"
          },
          "project_id": {
            "type": "integer",
            "description": "所属项目ID"
          },
          "user_id": {
            "type": "integer",
            "description": "创建者用户ID（可选）"
          }
        }
      },
      "CaseEditNameRequest": {
        "type": "object",
        "required": [
          "id",
          "name",
          "user_id"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "description": "方案ID"
          },
          "name": {
            "type": "string",
            "description": "新名称"
          },
          "user_id": {
            "type": "integer",
            "description": "操作用户ID"
          }
        }
      }
    }
  },
  "paths": {
    "/api/user/login": {
      "post": {
        "tags": [
          "用户管理"
        ],
        "summary": "用户登录",
        "description": "登录，返回 token 与用户信息",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "登录成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseJson"
                }
              }
            }
          }
        }
      }
    },
    "/api/user/change-password": {
      "post": {
        "tags": [
          "用户管理"
        ],
        "summary": "修改密码",
        "description": "修改用户密码",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "修改成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseJson"
                }
              }
            }
          }
        }
      }
    },
    "/api/project/page": {
      "get": {
        "tags": [
          "项目管理"
        ],
        "summary": "获取项目分页列表",
        "description": "获取项目分页列表",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "页码（1-based）"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 50
            },
            "description": "每页条数"
          },
          {
            "name": "name",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "可选名称过滤"
          }
        ],
        "responses": {
          "200": {
            "description": "获取成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseJson"
                }
              }
            }
          }
        }
      }
    },
    "/api/project/add": {
      "post": {
        "tags": [
          "项目管理"
        ],
        "summary": "创建项目",
        "description": "创建新项目",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProjectRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "创建成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseJson"
                }
              }
            }
          }
        }
      }
    },
    "/api/project/edit": {
      "post": {
        "tags": [
          "项目管理"
        ],
        "summary": "编辑项目",
        "description": "编辑项目信息",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProjectEditRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "编辑成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseJson"
                }
              }
            }
          }
        }
      }
    },
    "/api/project/detail": {
      "get": {
        "tags": [
          "项目管理"
        ],
        "summary": "获取项目详情",
        "description": "获取项目详细信息",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "项目ID"
          }
        ],
        "responses": {
          "200": {
            "description": "获取成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseJson"
                }
              }
            }
          }
        }
      }
    },
    "/api/project/del": {
      "post": {
        "tags": [
          "项目管理"
        ],
        "summary": "删除项目",
        "description": "删除指定项目",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProjectDeleteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "删除成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseJson"
                }
              }
            }
          }
        }
      }
    },
    "/api/project/clrtable": {
      "post": {
        "tags": [
          "项目管理"
        ],
        "summary": "清空项目基础表",
        "description": "清空指定项目的基础表数据",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClearTableRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "清空成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseJson"
                }
              }
            }
          }
        }
      }
    },
    "/api/project/overwrite": {
      "post": {
        "tags": [
          "项目管理"
        ],
        "summary": "覆盖项目基础表",
        "description": "覆盖指定项目的基础表数据",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OverwriteTableRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "覆盖成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseJson"
                }
              }
            }
          }
        }
      }
    },
    "/api/files/drosm": {
      "post": {
        "tags": [
          "文件管理"
        ],
        "summary": "上传OSM文件",
        "description": "上传道路/公交 OSM 文件进行导入",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "osm"
              ]
            },
            "description": "导入类型"
          },
          {
            "name": "project_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "目标项目ID"
          },
          {
            "name": "table",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "目标表名"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "OSM文件"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "上传成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseJson"
                }
              }
            }
          }
        }
      }
    },
    "/api/files/drcsv": {
      "post": {
        "tags": [
          "文件管理"
        ],
        "summary": "上传CSV/XLSX文件",
        "description": "上传 CSV/XLSX 等基础数据表文件",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "csv",
                "xlsx",
                "txt"
              ]
            },
            "description": "导入类型"
          },
          {
            "name": "project_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 31
            },
            "description": "目标项目ID"
          },
          {
            "name": "table",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "bus_community",
                "bus_point",
                "bus_way",
                "road_community",
                "road_point",
                "road_way",
                "other_od",
                "other_toll_gate",
                "other_mobile_cdr",
                "other_bus_card_records",
                "other_taxi_trip",
                "other_population"
              ]
            },
            "description": "目标表名"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "CSV/XLSX/TXT文件"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "上传成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseJson"
                }
              }
            }
          }
        }
      }
    },
    "/api/case_type/list": {
      "get": {
        "tags": [
          "方案管理"
        ],
        "summary": "获取方案类型列表",
        "description": "获取方案类型列表（不分页）",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "获取成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseJson"
                }
              }
            }
          }
        }
      }
    },
    "/api/case/list": {
      "get": {
        "tags": [
          "方案管理"
        ],
        "summary": "获取方案列表",
        "description": "获取方案列表",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "case_type_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "description": "方案类型ID"
          },
          {
            "name": "name",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "方案名称过滤"
          },
          {
            "name": "project_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "description": "项目ID"
          },
          {
            "name": "user_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "description": "用户ID"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "页码"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "description": "每页条数"
          },
          {
            "name": "username",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "用户名过滤"
          }
        ],
        "responses": {
          "200": {
            "description": "获取成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseJson"
                }
              }
            }
          }
        }
      }
    },
    "/api/case/add": {
      "post": {
        "tags": [
          "方案管理"
        ],
        "summary": "新增方案",
        "description": "新增一个方案（Case）",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CaseAddRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "新增成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseJson"
                }
              }
            }
          }
        }
      }
    },
    "/api/case/del/{id}": {
      "delete": {
        "tags": [
          "方案管理"
        ],
        "summary": "删除方案",
        "description": "删除指定方案",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "要删除的方案ID"
          }
        ],
        "responses": {
          "200": {
            "description": "删除成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseJson"
                }
              }
            }
          }
        }
      }
    },
    "/api/case/edit-name": {
      "post": {
        "tags": [
          "方案管理"
        ],
        "summary": "修改方案名称",
        "description": "修改方案名称",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CaseEditNameRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "修改成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseJson"
                }
              }
            }
          }
        }
      }
    },
    "/api/case/detail/{id}": {
      "get": {
        "tags": [
          "方案管理"
        ],
        "summary": "获取方案详情",
        "description": "获取项目方案详情",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "方案ID"
          }
        ],
        "responses": {
          "200": {
            "description": "获取成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseJson"
                }
              }
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "用户管理",
      "description": "用户登录、密码管理等接口"
    },
    {
      "name": "项目管理",
      "description": "项目的增删改查、表清空覆盖等接口"
    },
    {
      "name": "文件管理",
      "description": "文件上传导入等接口"
    },
    {
      "name": "方案管理",
      "description": "方案的增删改查等接口"
    }
  ]
}
