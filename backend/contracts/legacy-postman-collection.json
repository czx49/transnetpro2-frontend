{
  "info": {
    "name": "TransNetPro API Collection",
    "description": "TransNetPro 项目接口集合",
    "version": "1.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{authToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "用户管理",
      "item": [
        {
          "name": "用户登录",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"<CONFIGURE_LOCALLY>\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/user/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "user",
                "login"
              ]
            }
          }
        },
        {
          "name": "修改密码",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"oldPassword\": \"oldpass\",\n  \"newPassword\": \"newpass\",\n  \"confirmNewPassword\": \"newpass\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/user/change-password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "user",
                "change-password"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "项目管理",
      "item": [
        {
          "name": "获取项目分页列表",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/project/page?page=1&limit=50&name=",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "project",
                "page"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "50"
                },
                {
                  "key": "name",
                  "value": ""
                }
              ]
            }
          }
        },
        {
          "name": "创建项目",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"新项目\",\n  \"desc\": \"项目描述\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/project/add",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "project",
                "add"
              ]
            }
          }
        },
        {
          "name": "编辑项目",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 1,\n  \"name\": \"更新后的项目名\",\n  \"desc\": \"更新后的项目描述\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/project/edit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "project",
                "edit"
              ]
            }
          }
        },
        {
          "name": "获取项目详情",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/project/detail?id=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "project",
                "detail"
              ],
              "query": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "删除项目",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/project/del",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "project",
                "del"
              ]
            }
          }
        },
        {
          "name": "清空项目基础表",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"project_id\": 31,\n  \"table\": \"bus_community\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/project/clrtable",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "project",
                "clrtable"
              ]
            }
          }
        },
        {
          "name": "覆盖项目基础表",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"project_id\": 31,\n  \"table\": \"bus_community\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/project/overwrite",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "project",
                "overwrite"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "文件管理",
      "item": [
        {
          "name": "上传OSM文件",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/files/drosm?type=osm&project_id=31&table=road_way",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "files",
                "drosm"
              ],
              "query": [
                {
                  "key": "type",
                  "value": "osm"
                },
                {
                  "key": "project_id",
                  "value": "31"
                },
                {
                  "key": "table",
                  "value": "road_way"
                }
              ]
            }
          }
        },
        {
          "name": "上传CSV/XLSX文件",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/files/drcsv?type=csv&project_id=31&table=bus_community",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "files",
                "drcsv"
              ],
              "query": [
                {
                  "key": "type",
                  "value": "csv"
                },
                {
                  "key": "project_id",
                  "value": "31"
                },
                {
                  "key": "table",
                  "value": "bus_community"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "方案管理",
      "item": [
        {
          "name": "获取方案类型列表",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/case_type/list",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "case_type",
                "list"
              ]
            }
          }
        },
        {
          "name": "获取方案列表",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/case/list?case_type_id=1&project_id=31&page=1&limit=50",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "case",
                "list"
              ],
              "query": [
                {
                  "key": "case_type_id",
                  "value": "1"
                },
                {
                  "key": "project_id",
                  "value": "31"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "50"
                }
              ]
            }
          }
        },
        {
          "name": "新增方案",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"新方案\",\n  \"case_type_id\": 1,\n  \"road_types\": [\"highway\", \"primary\"],\n  \"bus_types\": [\"bus_stop\"],\n  \"other_types\": [],\n  \"project_id\": 31,\n  \"user_id\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/case/add",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "case",
                "add"
              ]
            }
          }
        },
        {
          "name": "删除方案",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/case/del/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "case",
                "del",
                "1"
              ]
            }
          }
        },
        {
          "name": "修改方案名称",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 1,\n  \"name\": \"更新后的方案名\",\n  \"user_id\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/case/edit-name",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "case",
                "edit-name"
              ]
            }
          }
        },
        {
          "name": "获取方案详情",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/case/detail/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "case",
                "detail",
                "1"
              ]
            }
          }
        }
      ]
    }
  ]
}
