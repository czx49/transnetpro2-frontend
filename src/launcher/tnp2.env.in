# tnp2.env — 与 tnp2_launcher.exe 同目录
# 占位符：%LAUNCHER_DIR% = 启动器所在目录（通常即包内 bin/）
#         %PACKAGE_ROOT% = %LAUNCHER_DIR% 的上一级（包根）
# 布局 A：QGIS providers/resources 在 bin/；Qt 插件在包根 plugins/

TARGET_EXE=tnp2_app.exe
WORKING_DIR=%LAUNCHER_DIR%

PATH=%LAUNCHER_DIR%;%LAUNCHER_DIR%\depends;%LAUNCHER_DIR%\WebView2;%PACKAGE_ROOT%\gdalplugins;%PATH%

PROJ_LIB=%PACKAGE_ROOT%\share\proj
GDAL_DATA=%PACKAGE_ROOT%\share\gdal
GDAL_DRIVER_PATH=%PACKAGE_ROOT%\gdalplugins
QGIS_PREFIX_PATH=%LAUNCHER_DIR%
QGIS_PLUGINPATH=%LAUNCHER_DIR%\plugins
QT_PLUGIN_PATH=%PACKAGE_ROOT%\plugins
