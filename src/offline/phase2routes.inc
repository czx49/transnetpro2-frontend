// Included in offlineapi.cpp: local implementation of the Phase2 API contract.
QString allowedTable(const QString& input) {
    QString name=input.section(':',-1).section('.',-1);name.remove('"');
    auto q=sql("SELECT physical_name FROM tnp2_local.data_tables WHERE physical_name=?",{name});
    if(!q.next())throw Failure{u8"图层不属于本机二期工程："+name};return q.value(0).toString();
}
QString tableParameter(int p,int c,const QString& value) {
    try {return tableFor(p,c,value);}catch(const Failure&) {
        QString logical=value.section(':',-1).section('.',-1);
        if(logical.startsWith(prefix(p,c)))logical=logical.mid(prefix(p,c).size());
        return tableFor(p,c,logical);
    }
}
void cloneTables(int p,int fromCase,int targetCase) {
    const auto sourceTables=rows("SELECT * FROM tnp2_local.data_tables WHERE project_id=? AND case_id=?",{p,fromCase});
    for(const auto& value:sourceTables) {
        const auto t=value.toObject();const QString name=prefix(p,targetCase)+t["logical_name"].toString();
        sql("CREATE TABLE "+qualified(name)+" (LIKE "+qualified(t["physical_name"].toString())+" INCLUDING ALL EXCLUDING IDENTITY)");
        sql("ALTER TABLE "+qualified(name)+" ALTER COLUMN id DROP DEFAULT");
        sql("ALTER TABLE "+qualified(name)+" ALTER COLUMN id ADD GENERATED BY DEFAULT AS IDENTITY");
        sql("INSERT INTO "+qualified(name)+" SELECT * FROM "+qualified(t["physical_name"].toString()));
        sql("SELECT setval(pg_get_serial_sequence(?,'id'),GREATEST((SELECT coalesce(max(id),1) FROM "+qualified(name)+"),1))",{"tnp2_data."+name});
        sql("INSERT INTO tnp2_local.data_tables VALUES(?,?,?,?,?,?)",{p,targetCase,t["logical_name"].toString(),name,t["display_name"].toString(),t["category"].toString()});
    }
}
QJsonObject createCase(int p,const QString& rawName,int sourceCase=0) {
    project(p);QString name=rawName.trimmed();if(name.isEmpty())throw Failure{u8"方案名称不能为空。"};
    auto base=sql("SELECT 1 FROM tnp2_local.cases WHERE project_id=? AND isbase=1",{p});const bool isbase=!base.next();
    auto q=sql("INSERT INTO tnp2_local.cases(project_id,name,isbase) VALUES(?,?,?) RETURNING id",{p,name,isbase?1:0});q.next();const int id=q.value(0).toInt();
    cloneTables(p,sourceCase,id);return caseDetail(id);
}
QJsonObject dataPage(const QString& input,int page,int limit) {
    const QString table=allowedTable(input);page=qMax(1,page);limit=qBound(1,limit,1000);
    auto count=sql("SELECT count(*) FROM "+qualified(table));count.next();const int total=count.value(0).toInt();
    QStringList selected;for(const auto& column:columns(table))selected<<(column=="geom"?"ST_AsText(geom) AS geometry":qi(column));
    return {{"data",rows("SELECT "+selected.join(',')+" FROM "+qualified(table)+" ORDER BY id LIMIT ? OFFSET ?",{limit,(page-1)*limit})},
        {"total",total},{"page",page},{"limit",limit},{"totalPages",(total+limit-1)/limit}};
}
QString statsHtml(int p,int c=0) {
    QString html=u8"<html><meta charset='utf-8'><body><h2>本地数据统计</h2><table border='1' cellpadding='7'><tr><th>图层</th><th>记录数</th></tr>";
    const auto n=counts(p,c);auto tables=rows("SELECT logical_name,display_name FROM tnp2_local.data_tables WHERE project_id=? AND case_id=? ORDER BY category,logical_name",{p,c});
    for(const auto& value:tables){const auto t=value.toObject();html+="<tr><td>"+t["display_name"].toString().toHtmlEscaped()+"</td><td>"+QString::number(n[t["logical_name"].toString()].toDouble(),'f',0)+"</td></tr>";}
    return html+u8"</table><p>此表为本机数据记录统计，尚未执行交通规划分析算法。</p></body></html>";
}
QJsonValue phase2Route(const QString& method,const QString& path,const QVariantMap& v,const QString& file) {
    const int p=v.value("project_id",v.value("id")).toInt(),c=v.value("case_id",0).toInt();
    if(path=="/api/config/getversion")return QJsonObject{{"version","2.0.0"},{"desc",u8"二期离线版"}};
    if(path=="/api/user/login")return QJsonObject{{"token","phase2-local-session"},{"user",QJsonObject{{"user_id",1},{"username","offline"},{"real_name",u8"本地用户"},{"status",1}}}};
    if(path=="/api/config/base")return QJsonObject{{"site_name",u8"城市道路交通网络预测与分析平台"},{"tit1",u8"城市综合交通网络预测与管理"},{"tit2",u8"欢迎使用离线版"},{"mapurl2",""},{"mapurl3",""},{"help_list",QJsonArray{}},{"titlist",QJsonArray{}}};
    if(path=="/api/config/field_chinese")return QJsonObject{{"id",u8"编号"},{"node_id",u8"节点编号"},{"link_id",u8"路段编号"},{"name",u8"名称"},{"length",u8"长度"},{"capacity",u8"通行能力"},{"demand",u8"需求量"},{"area_id",u8"小区编号"},{"pop_sum",u8"人口总量"}};
    if(path=="/api/config/regions")return QJsonArray{QJsonObject{{"id",1},{"name",v.value("province").toInt()?u8"未指定城市":u8"离线区域"}}};
    if(path=="/api/config/aiconfig")return QJsonObject{};
    if(path=="/api/config/question"||path=="/api/news")return QJsonArray{};
    if(path=="/api/user/change-password")throw Failure{u8"离线版使用当前 Windows 用户，无需服务器密码。"};
    if(path=="/api/project/add") {
        const QString name=v.value("name").toString().trimmed();if(name.isEmpty())throw Failure{u8"项目名称不能为空。"};
        auto q=sql("INSERT INTO tnp2_local.projects(name,description,province_id,province,city_id,city) VALUES(?,?,?,?,?,?) RETURNING id",{name,v.value("desc",""),v.value("province_id",0),v.value("province",""),v.value("city_id",0),v.value("city","")});
        q.next();int id=q.value(0).toInt();ensureTables(id);return QJsonObject{{"id",id},{"project_id",id}};
    }
    if(path=="/api/project/page") {
        auto all=rows("SELECT p.*,p.description AS desc,1 AS status,0 AS sort,ARRAY[1] AS users,(SELECT count(*) FROM tnp2_local.cases c WHERE c.project_id=p.id) AS num FROM tnp2_local.projects p WHERE position(lower(?) in lower(name))>0 ORDER BY id DESC",{v.value("name","")});
        int page=qMax(1,v.value("page",1).toInt()),limit=qBound(1,v.value("limit",50).toInt(),100);QJsonArray data;for(int i=(page-1)*limit;i<qMin(page*limit,all.size());++i)data.append(all[i]);
        return QJsonObject{{"data",data},{"total",all.size()},{"totalPages",(all.size()+limit-1)/limit},{"page",page},{"limit",limit}};
    }
    if(path=="/api/project/detail") {
        auto info=project(p);ensureTables(p);
        QJsonArray tools{QJsonObject{{"name",u8"生成交通小区"},{"type","openarea"}},QJsonObject{{"name",u8"基础数据分析"},{"type","base_analysis"}},QJsonObject{{"name",u8"OD数据生成"},{"type","trip_model_all"}}};
        return QJsonObject{{"info",info},{"dbfix","tnp2_data"},{"dbuserfix",prefix(p)},{"db_conn_str",connection(p)},{"menu",menu(p)},{"tools",tools},{"algorithm_params",QJsonObject{}}};
    }
    if(path=="/api/project/edit") {project(p);sql("UPDATE tnp2_local.projects SET name=?,description=?,province_id=?,province=?,city_id=?,city=?,updated_at=now() WHERE id=?",{v.value("name").toString().trimmed(),v.value("desc",""),v.value("province_id",0),v.value("province",""),v.value("city_id",0),v.value("city",""),p});return true;}
    if(path=="/api/project/del") {
        project(p);auto q=sql("SELECT physical_name FROM tnp2_local.data_tables WHERE project_id=? ORDER BY case_id DESC",{p});while(q.next())sql("DROP TABLE "+qualified(q.value(0).toString()));sql("DELETE FROM tnp2_local.projects WHERE id=?",{p});return true;
    }
    if(path=="/api/project/clrtable"){sql("DELETE FROM "+qualified(tableParameter(p,c,v.value("table").toString())));return true;}
    if(path=="/api/project/export")return exportTable(p,c,v.value("table").toString(),v.value("type","csv").toString());
    if(path=="/api/files/drcsv"||path=="/api/files/drshpzip") {
        project(p);if(c&&caseDetail(c)["project_id"].toInt()!=p)throw Failure{u8"方案不属于当前项目。"};
        const QString target=tableParameter(p,c,v.value("table").toString());
        auto dataset=source(file.section("|layername=",0,0));const QString selected=file.section("|layername=",1,1);
        auto* layer=selected.isEmpty()?dataset->GetLayer(0):dataset->GetLayerByName(selected.toUtf8().constData());
        // Phase2 import replaces a dataset; both DELETE and INSERT are in this request's transaction.
        sql("DELETE FROM "+qualified(target));const int imported=importLayer(layer,target);
        return QJsonObject{{"success",true},{"inserted",imported},{"imported",imported}};
    }
    if(path=="/api/case/add")return createCase(p,v.value("name").toString());
    if(path=="/api/case/copy") {auto original=caseDetail(c);return createCase(original["project_id"].toInt(),v.value("name",original["name"].toString()+u8" 副本").toString(),c);}
    if(path=="/api/case/copyproject") {
        auto detail=caseDetail(c);int id=detail["project_id"].toInt();auto q=sql("SELECT logical_name,physical_name FROM tnp2_local.data_tables WHERE project_id=? AND case_id=?",{id,c});
        while(q.next()){const QString target=tableFor(id,0,q.value(0).toString());sql("DELETE FROM "+qualified(target));sql("INSERT INTO "+qualified(target)+" SELECT * FROM "+qualified(q.value(1).toString()));}return true;
    }
    if(path=="/api/case/listAll") {QJsonArray data;auto q=sql("SELECT id FROM tnp2_local.cases ORDER BY id");while(q.next())data.append(caseDetail(q.value(0).toInt()));return data;}
    if(path=="/api/case/list") {
        auto ids=sql("SELECT id FROM tnp2_local.cases WHERE project_id=? ORDER BY isbase DESC,id",{p});QJsonArray all;while(ids.next())all.append(caseDetail(ids.value(0).toInt()));
        int page=qMax(1,v.value("page",1).toInt()),limit=qBound(1,v.value("limit",50).toInt(),100);QJsonArray data;for(int i=(page-1)*limit;i<qMin(page*limit,all.size());++i)data.append(all[i]);
        return QJsonObject{{"data",data},{"total",all.size()},{"totalPages",(all.size()+limit-1)/limit},{"page",page},{"limit",limit}};
    }
    if(path.startsWith("/api/case/detail/"))return caseDetail(path.section('/',-1).toInt());
    if(path.startsWith("/api/case/del/")&&method=="DELETE") {
        int id=path.section('/',-1).toInt();auto detail=caseDetail(id);auto q=sql("SELECT physical_name FROM tnp2_local.data_tables WHERE case_id=?",{id});while(q.next())sql("DROP TABLE "+qualified(q.value(0).toString()));
        sql("DELETE FROM tnp2_local.data_tables WHERE case_id=?",{id});sql("DELETE FROM tnp2_local.cases WHERE id=?",{id});return true;
    }
    if(path=="/api/case/edit-name"||path=="/api/case/edit") {caseDetail(v.value("id").toInt());sql("UPDATE tnp2_local.cases SET name=?,updated_at=now() WHERE id=?",{v.value("name").toString().trimmed(),v.value("id")});return true;}
    if(path=="/api/case/edit-status") {if(v.value("status").toInt()!=0)throw Failure{u8"离线分析尚未执行，不能标记为计算完成。"};sql("UPDATE tnp2_local.cases SET status=0 WHERE id=?",{v.value("id")});return true;}
    if(path=="/api/case/edit-result") {sql("UPDATE tnp2_local.cases SET result=? WHERE id=?",{v.value("result"),v.value("id")});return true;}
    if(path=="/api/project/select_data_page")return dataPage(v.value("tablefullname").toString(),v.value("page",1).toInt(),v.value("limit",50).toInt());
    if(path=="/api/project/select_data_all"){
        const QString table=allowedTable(v.value("tablefullname").toString());QStringList fields;
        for(const auto& column:columns(table))fields<<(column=="geom"?"ST_AsText(geom) AS geometry":qi(column));
        return rows("SELECT "+fields.join(',')+" FROM "+qualified(table)+" ORDER BY id");
    }
    if(path=="/api/project/check_obs")return QJsonObject{{"obs",counts(p,0)["other_observation"].toInt()>0?1:0}};
    if(path=="/api/case/basedata_view"||path=="/api/project/base_analysis")return QJsonObject{{"content",statsHtml(p)}};
    if(path=="/api/project/update_centroid") {
        const QString table=tableParameter(p,c,v.value("tablefullname").toString());const QString logical=one("SELECT logical_name FROM tnp2_local.data_tables WHERE physical_name=?",{table})["logical_name"].toString();
        QString key=logical;key.replace("community","point");QString target=tableFor(p,c,key);
        sql("DELETE FROM "+qualified(target));sql("INSERT INTO "+qualified(target)+" (node_id,name,geom) SELECT area_id,name,ST_Centroid(geom) FROM "+qualified(table)+" WHERE geom IS NOT NULL");return true;
    }
    if(path=="/api/project/popdata") {
        const QString target=tableFor(p,0,"road_community");for(const auto& item:v.value("data").toList()){auto row=item.toMap();sql("UPDATE "+qualified(target)+" SET pop_sum=? WHERE area_id=?",{row.value("pop_sum"),row.value("area_id")});}
        return QJsonObject{{"message",u8"本地人口统计已保存"}};
    }
    if(path=="/api/project/gen_community") {
        const QString target=tableFor(p,0,"road_community");sql("DELETE FROM "+qualified(target));int inserted=0;
        for(const auto& item:v.value("data").toList()){auto row=item.toMap();const QString geometry=QString::fromUtf8(QJsonDocument(QJsonObject::fromVariantMap(row.value("geometry").toMap())).toJson(QJsonDocument::Compact));
            sql("INSERT INTO "+qualified(target)+" (area_id,pop_sum,num_grids,seed_oid,geom) VALUES(?,?,?,?,ST_SetSRID(ST_GeomFromGeoJSON(?),4326))",{row.value("area_id"),row.value("pop_sum"),row.value("num_grids"),row.value("seed_oid"),geometry});++inserted;}
        return QJsonObject{{"success",true},{"inserted",inserted},{"message",u8"本地交通小区已保存"}};
    }
    if(path=="/api/case/fieldbatch") {
        const QString table=tableParameter(p,c,v.value("tablefullname").toString()),field=v.value("field").toString();
        if(!columns(table).contains(field)||field=="id"||field=="geom")throw Failure{u8"不允许批量修改该字段。"};
        const QString type=v.value("type").toString();QString expression;
        if(type=="3"||type=="multiply"||type=="mul")expression=qi(field)+" * ?";
        else if(type=="1"||type=="add")expression=qi(field)+" + ?";
        else if(type=="2"||type=="subtract")expression=qi(field)+" - ?";
        else throw Failure{u8"不支持的字段批量操作类型。"};
        sql("UPDATE "+qualified(table)+" SET "+qi(field)+"="+expression,{v.value("num")});return true;
    }
    if(path=="/api/case/editlog")throw Failure{u8"本地地图修改已直接保存到 PostgreSQL；服务端格式的改造记录尚未接入离线版。"};
    if(path=="/api/grpc/check")throw Failure{u8"本地工程可编辑和对比；服务端交通分析引擎尚未安装为离线模块，当前无法执行自动分析。"};
    if(path.startsWith("/api/grpc/")||path=="/api/case/report_view"||path=="/api/case/report_download")throw Failure{u8"此功能需要配套的离线算法或报告引擎，当前安装包未提供。项目、图层、方案和地图编辑可继续使用。"};
    throw Failure{u8"该功能尚未接入离线处理："+path};
}
