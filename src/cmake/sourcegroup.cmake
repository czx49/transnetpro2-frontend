function(set_interface_sources TARGET_NAME _HEADERS _SOURCES _FORMS)
	set_property(TARGET ${TARGET_NAME} PROPERTY INTERFACE_${TARGET_NAME}_HEADERS "${_HEADERS}")
	set_property(TARGET ${TARGET_NAME} PROPERTY INTERFACE_${TARGET_NAME}_SOURCES "${_SOURCES}")
	set_property(TARGET ${TARGET_NAME} PROPERTY INTERFACE_${TARGET_NAME}_FORMS "${_FORMS}")
endfunction()

#��ָ��ģ���Դ����ӵ�Դ����������Ŀ¼��ʾ����ģ��ʹ��
function(group_interface_source TARGET_NAME)
	get_property(${TARGET_NAME}_HEADERS TARGET ${TARGET_NAME} PROPERTY INTERFACE_${TARGET_NAME}_HEADERS)
	get_property(${TARGET_NAME}_SOURCES TARGET ${TARGET_NAME} PROPERTY INTERFACE_${TARGET_NAME}_SOURCES)
	get_property(${TARGET_NAME}_FORMS TARGET ${TARGET_NAME} PROPERTY INTERFACE_${TARGET_NAME}_FORMS)
	source_group(TREE "${CMAKE_CURRENT_SOURCE_DIR}" PREFIX "Header Files" FILES ${${TARGET_NAME}_HEADERS})
	source_group(TREE "${CMAKE_CURRENT_SOURCE_DIR}" PREFIX "Source Files" FILES ${${TARGET_NAME}_SOURCES})
	source_group(TREE "${CMAKE_CURRENT_SOURCE_DIR}" PREFIX "Form Files" FILES ${${TARGET_NAME}_FORMS})
endfunction()