cmake_minimum_required(VERSION 3.16)

# 设置Debug模式下，库的后缀名带d
set(CMAKE_DEBUG_POSTFIX d)

# 获取当前脚本文件所在目录
message(CMAKE_CURRENT_SOURCE_DIR=${CMAKE_CURRENT_SOURCE_DIR})

#定义安装输出路径
if(WIN32)
    set(DEFAULT_BIN_SUBDIR     ${CMAKE_CURRENT_SOURCE_DIR}/../out/bin)
    set(DEFAULT_LIB_SUBDIR     ${CMAKE_CURRENT_SOURCE_DIR}/../out/lib)
elseif(UNIX)
    set(DEFAULT_BIN_SUBDIR     ${CMAKE_CURRENT_SOURCE_DIR}/../out/bin)
    set(DEFAULT_LIB_SUBDIR     ${CMAKE_CURRENT_SOURCE_DIR}/../out/lib${LIB_SUFFIX})
endif()
foreach(OUTPUTCONFIG ${CMAKE_CONFIGURATION_TYPES})
    string(TOUPPER ${OUTPUTCONFIG} OUTPUTCONFIG)
    set(CMAKE_ARCHIVE_OUTPUT_DIRECTORY_${OUTPUTCONFIG} ${DEFAULT_LIB_SUBDIR})
    set(CMAKE_RUNTIME_OUTPUT_DIRECTORY_${OUTPUTCONFIG} ${DEFAULT_BIN_SUBDIR})
endforeach()
set(CMAKE_ARCHIVE_OUTPUT_DIRECTORY ${DEFAULT_LIB_SUBDIR})
set(CMAKE_RUNTIME_OUTPUT_DIRECTORY ${DEFAULT_BIN_SUBDIR})
set(CMAKE_LIBRARY_OUTPUT_DIRECTORY ${DEFAULT_BIN_SUBDIR})
